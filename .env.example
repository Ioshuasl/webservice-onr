ACOMPANHAMENTO_TITULOS_PAGE_NUMBER=1
ACOMPANHAMENTO_TITULOS_PROTOCOLO=
ACOMPANHAMENTO_TITULOS_DATA_PROTOCOLO_INICIO=2025-01-01
ACOMPANHAMENTO_TITULOS_DATA_PROTOCOLO_FINAL=2026-12-31
ACOMPANHAMENTO_TITULOS_ID_TIPO_STATUS=-1
ACOMPANHAMENTO_TITULOS_EXPORTADO=-1
ACOMPANHAMENTO_TITULOS_APRESENTANTE=

# GetTituloAT / ListStatusAT — ID do título
ACOMPANHAMENTO_TITULOS_ID_TITULO=18151720

# GetStatusAT — ID do cadastro de status
ACOMPANHAMENTO_TITULOS_ID_STATUS=66701083

# ListStatusAT — filtro opcional de datas do status (aaaa-mm-dd)
ACOMPANHAMENTO_TITULOS_DATA_STATUS_INICIO=
ACOMPANHAMENTO_TITULOS_DATA_STATUS_FINAL=

# InsertTituloAT — cadastro de título + status inicial
# TipoSolicitacao: 1 = Prenotação, 2 = Exame e Cálculo
# ModoNotificacao: E = e-mail (exige APRESENTANTE_EMAIL), S = SMS (exige DDD e TELEFONE)
# Datas: formato aaaa-mm-ddhh:mm:ss (19 caracteres)
# Somente dígitos, até 11 caracteres (ex. título existente: 605762)
ACOMPANHAMENTO_TITULOS_INSERT_PROTOCOLO=887766
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_NOME=
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_EMAIL=
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_DDD=
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_TELEFONE=
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_CPFCNPJ=
ACOMPANHAMENTO_TITULOS_INSERT_VALOR_DEPOSITO=0
ACOMPANHAMENTO_TITULOS_INSERT_VALOR_EMOLUMENTOS=0
ACOMPANHAMENTO_TITULOS_INSERT_DATA_PROTOCOLO=
ACOMPANHAMENTO_TITULOS_INSERT_DATA_PREVISAO_ENTREGA=
ACOMPANHAMENTO_TITULOS_INSERT_MODO_NOTIFICACAO=E
ACOMPANHAMENTO_TITULOS_INSERT_INTERESSADO_NOME=
ACOMPANHAMENTO_TITULOS_INSERT_INTERESSADO_CPFCNPJ=
ACOMPANHAMENTO_TITULOS_INSERT_NATUREZA_TITULO=
# Obrigatório na prática (serviço retorna erro 36 se vazio). Ex.: copie de GetTituloAT.
ACOMPANHAMENTO_TITULOS_INSERT_CODIGO_VERIFICADOR=
ACOMPANHAMENTO_TITULOS_INSERT_TIPO_SOLICITACAO=1
# Status inicial sugerido para cadastro novo: 4 = Título prenotado (§ 3.2.1)
ACOMPANHAMENTO_TITULOS_INSERT_ID_TIPO_STATUS=4
ACOMPANHAMENTO_TITULOS_INSERT_DATA_STATUS=
ACOMPANHAMENTO_TITULOS_INSERT_DESCRICAO_STATUS=

# UpdateTituloAT — alteração de título existente
# ID_TITULO: use UPDATE_ID_TITULO ou ACOMPANHAMENTO_TITULOS_ID_TITULO
# Preencha com dados atuais do título (GetTituloAT) + o que deseja alterar
ACOMPANHAMENTO_TITULOS_UPDATE_ID_TITULO=
ACOMPANHAMENTO_TITULOS_UPDATE_PROTOCOLO=
ACOMPANHAMENTO_TITULOS_UPDATE_APRESENTANTE_NOME=
