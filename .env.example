# Postman API — sync coleções (npm run postman:sync / postman:sync:ccn)
# API key: https://go.postman.co/settings/me/api-keys — vault env.md
# Collection UID: Share da coleção → Via API (ou npm run postman:sync:ccn:create)
POSTMAN_API_KEY=
POSTMAN_COLLECTION_UID=
# Opcional, só para npm run postman:sync:create
POSTMAN_WORKSPACE_ID=
