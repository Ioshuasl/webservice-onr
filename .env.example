# Caminho do certificado (.pfx / .p12)
CERT_PATH=C:\Users\kenio\OneDrive\Desktop\PALMELO CARTORIO DO PRIMEIRO OFICIO E REGISTRO IM - senha - Hugo54.pfx
CERT_PASSWORD=Hugo54

# Dados de homologação ONR (fornecidos pela ONR / cadastro)
CPF=00000000000
EMAIL=seu.email@exemplo.com.br
ONR_SERVENTIA_ID=0

# SOAP login (opcional — padrões abaixo)
ONR_WSDL_LOGIN_PATH=wsdl/login.wsdl
ONR_LOGIN_ENDPOINT=https://hml3-wsoficio.onr.org.br/login.asmx

# Formato da chave pública enviada ao WS: base64_der | pem | pem_stripped
PUBLICKEY_FORMAT=base64_der

# Formato da validade: iso | br_datetime | br_date
VALIDUNTIL_FORMAT=iso

# Chave única da serventia (fornecida pela ONR via oficioeletronico@onr.org)
ONR_SERVENTIA_CHAVE=
# Login automático: obtém token e calcula Hash = SHA-1(chave + token)
ACOMPANHAMENTO_TITULOS_AUTO_LOGIN=true
# Índice do token retornado pelo login (0–4). Cada token é de uso único.
ONR_HASH_TOKEN_INDEX=0
# Opcional: informar Hash já calculado (pula login e SHA-1)
# ONR_HASH_OVERRIDE=

# Acompanhamento de Títulos — ListTitulosAT
ACOMPANHAMENTO_TITULOS_WSDL_PATH=wsdl/acompanhamentotitulos.wsdl
ACOMPANHAMENTO_TITULOS_ENDPOINT=https://hml3-wsoficio.onr.org.br/acompanhamentotitulos.asmx
ACOMPANHAMENTO_TITULOS_MAX_ROW_PER_PAGE=50
ACOMPANHAMENTO_TITULOS_PAGE_NUMBER=1
ACOMPANHAMENTO_TITULOS_PROTOCOLO=
ACOMPANHAMENTO_TITULOS_DATA_PROTOCOLO_INICIO=2025-01-01
ACOMPANHAMENTO_TITULOS_DATA_PROTOCOLO_FINAL=2026-12-31
ACOMPANHAMENTO_TITULOS_ID_TIPO_STATUS=-1
ACOMPANHAMENTO_TITULOS_EXPORTADO=-1
ACOMPANHAMENTO_TITULOS_APRESENTANTE=

# GetTituloAT / ListStatusAT — ID do título
ACOMPANHAMENTO_TITULOS_ID_TITULO=18151720

# GetStatusAT — ID do cadastro de status
ACOMPANHAMENTO_TITULOS_ID_STATUS=66701083

# ListStatusAT — filtro opcional de datas do status (aaaa-mm-dd)
ACOMPANHAMENTO_TITULOS_DATA_STATUS_INICIO=
ACOMPANHAMENTO_TITULOS_DATA_STATUS_FINAL=

# InsertTituloAT — cadastro de título + status inicial
# TipoSolicitacao: 1 = Prenotação, 2 = Exame e Cálculo
# ModoNotificacao: E = e-mail (exige APRESENTANTE_EMAIL), S = SMS (exige DDD e TELEFONE)
# Datas: formato aaaa-mm-ddhh:mm:ss (19 caracteres)
# Somente dígitos, até 11 caracteres (ex. título existente: 605762)
ACOMPANHAMENTO_TITULOS_INSERT_PROTOCOLO=887766
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_NOME=
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_EMAIL=
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_DDD=
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_TELEFONE=
ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_CPFCNPJ=
ACOMPANHAMENTO_TITULOS_INSERT_VALOR_DEPOSITO=0
ACOMPANHAMENTO_TITULOS_INSERT_VALOR_EMOLUMENTOS=0
ACOMPANHAMENTO_TITULOS_INSERT_DATA_PROTOCOLO=
ACOMPANHAMENTO_TITULOS_INSERT_DATA_PREVISAO_ENTREGA=
ACOMPANHAMENTO_TITULOS_INSERT_MODO_NOTIFICACAO=E
ACOMPANHAMENTO_TITULOS_INSERT_INTERESSADO_NOME=
ACOMPANHAMENTO_TITULOS_INSERT_INTERESSADO_CPFCNPJ=
ACOMPANHAMENTO_TITULOS_INSERT_NATUREZA_TITULO=
# Obrigatório na prática (serviço retorna erro 36 se vazio). Ex.: copie de GetTituloAT.
ACOMPANHAMENTO_TITULOS_INSERT_CODIGO_VERIFICADOR=
ACOMPANHAMENTO_TITULOS_INSERT_TIPO_SOLICITACAO=1
# Status inicial sugerido para cadastro novo: 4 = Título prenotado (§ 3.2.1)
ACOMPANHAMENTO_TITULOS_INSERT_ID_TIPO_STATUS=4
ACOMPANHAMENTO_TITULOS_INSERT_DATA_STATUS=
ACOMPANHAMENTO_TITULOS_INSERT_DESCRICAO_STATUS=

# UpdateTituloAT — alteração de título existente
# ID_TITULO: use UPDATE_ID_TITULO ou ACOMPANHAMENTO_TITULOS_ID_TITULO
# Preencha com dados atuais do título (GetTituloAT) + o que deseja alterar
ACOMPANHAMENTO_TITULOS_UPDATE_ID_TITULO=
ACOMPANHAMENTO_TITULOS_UPDATE_PROTOCOLO=
ACOMPANHAMENTO_TITULOS_UPDATE_APRESENTANTE_NOME=
ACOMPANHAMENTO_TITULOS_UPDATE_APRESENTANTE_EMAIL=
ACOMPANHAMENTO_TITULOS_UPDATE_APRESENTANTE_DDD=
ACOMPANHAMENTO_TITULOS_UPDATE_APRESENTANTE_TELEFONE=
ACOMPANHAMENTO_TITULOS_UPDATE_APRESENTANTE_CPFCNPJ=
ACOMPANHAMENTO_TITULOS_UPDATE_VALOR_DEPOSITO=0
ACOMPANHAMENTO_TITULOS_UPDATE_VALOR_EMOLUMENTOS=0
ACOMPANHAMENTO_TITULOS_UPDATE_DATA_PROTOCOLO=
ACOMPANHAMENTO_TITULOS_UPDATE_DATA_PREVISAO_ENTREGA=
ACOMPANHAMENTO_TITULOS_UPDATE_MODO_NOTIFICACAO=E
ACOMPANHAMENTO_TITULOS_UPDATE_INTERESSADO_NOME=
ACOMPANHAMENTO_TITULOS_UPDATE_INTERESSADO_CPFCNPJ=
ACOMPANHAMENTO_TITULOS_UPDATE_NATUREZA_TITULO=
ACOMPANHAMENTO_TITULOS_UPDATE_CODIGO_VERIFICADOR=
ACOMPANHAMENTO_TITULOS_UPDATE_TIPO_SOLICITACAO=1

# DeleteTituloAT — exclusão de título (irreversível na homologação)
# ID_TITULO: use DELETE_ID_TITULO ou ACOMPANHAMENTO_TITULOS_ID_TITULO
ACOMPANHAMENTO_TITULOS_DELETE_ID_TITULO=

# InsertStatusAT — novo status em título existente
# ID_TITULO: use INSERT_STATUS_ID_TITULO ou ACOMPANHAMENTO_TITULOS_ID_TITULO
# Tipos de status: § 3.2.1 (ex.: 3 = pronto para retirada, 7 = nota de exigência)
ACOMPANHAMENTO_TITULOS_INSERT_STATUS_ID_TITULO=
ACOMPANHAMENTO_TITULOS_INSERT_STATUS_ID_TIPO_STATUS=3
ACOMPANHAMENTO_TITULOS_INSERT_STATUS_DATA_STATUS=
ACOMPANHAMENTO_TITULOS_INSERT_STATUS_DESCRICAO_STATUS=

# UpdateStatusAT — alteração de status existente
# ID_STATUS: use UPDATE_STATUS_ID_STATUS ou ACOMPANHAMENTO_TITULOS_ID_STATUS
ACOMPANHAMENTO_TITULOS_UPDATE_STATUS_ID_STATUS=
ACOMPANHAMENTO_TITULOS_UPDATE_STATUS_ID_TIPO_STATUS=3
ACOMPANHAMENTO_TITULOS_UPDATE_STATUS_DATA_STATUS=
ACOMPANHAMENTO_TITULOS_UPDATE_STATUS_DESCRICAO_STATUS=

# Penhora Online — ListVarasPO (§ 3.3.3): -1 = todos
PENHORA_ONLINE_ID_ESTADO=-1
PENHORA_ONLINE_ID_COMARCA=-1
PENHORA_ONLINE_ID_FORO=-1

# Penhora Online — GetPedidoPO (§ 3.3.5): ID obtido em ListPedidosPO
PENHORA_ONLINE_ID_PEDIDO=

# Penhora Online — ListBoletosPO (§ 3.3.7): IDProcesso retornado em GetPedidoPO
PENHORA_ONLINE_ID_PROCESSO=

# Penhora Online — SetBaixaBoletoPO (§ 3.3.9): IDBoleto de ListBoletosPO
# PENHORA_ONLINE_SET_BAIXA_ID_BOLETO tem prioridade sobre PENHORA_ONLINE_ID_BOLETO
PENHORA_ONLINE_ID_BOLETO=
PENHORA_ONLINE_SET_BAIXA_ID_BOLETO=

# Penhora Online — SetPrenotacaoPO (§ 3.3.11): pedido tipo Penhora (IDTipoPedido=3)
# ID_PEDIDO: usa PENHORA_ONLINE_ID_PEDIDO se omitido
PENHORA_ONLINE_SET_PRENOTACAO_ID_PEDIDO=
PENHORA_ONLINE_SET_PRENOTACAO_NUMERO=
# Datas no formato aaaa-mm-dd
PENHORA_ONLINE_SET_PRENOTACAO_DATA_PRENOTACAO=
PENHORA_ONLINE_SET_PRENOTACAO_DATA_VENCIMENTO=

# Penhora Online — SetCustasPO (§ 3.3.13): pedido tipo Penhora com prenotação
PENHORA_ONLINE_SET_CUSTAS_ID_PEDIDO=
PENHORA_ONLINE_SET_CUSTAS_VALOR=50.00

# Penhora Online — SetPenhoraAverbadoPO (§ 3.3.15): resposta + certidões (URL pública; spec .p7s, homolog aceitou .pdf)
PENHORA_ONLINE_SET_PENHORA_AVERBADO_ID_PEDIDO=
PENHORA_ONLINE_SET_PENHORA_AVERBADO_RESPOSTA=
# Uma certidão:
PENHORA_ONLINE_SET_PENHORA_AVERBADO_MATRICULA=
PENHORA_ONLINE_SET_PENHORA_AVERBADO_URL_ARQUIVO=
# Ou várias: [{"Matricula":"12345","URLArquivo":"https://..."}]
PENHORA_ONLINE_SET_PENHORA_AVERBADO_CERTIDOES_JSON=

# Penhora Online — SetPenhoraExigenciaPO (§ 3.3.19): nota de exigência + anexos
# Pedido deve ser Penhora (tipo 3), prenotado e SEM resposta prévia (IDStatus 9/10, não 2/5/14).
# URLArquivo: URL pública .pdf ou .p7s acessível pelo servidor ONR.
PENHORA_ONLINE_SET_PENHORA_EXIGENCIA_ID_PEDIDO=
PENHORA_ONLINE_SET_PENHORA_EXIGENCIA_RESPOSTA=
PENHORA_ONLINE_SET_PENHORA_EXIGENCIA_NOME=
PENHORA_ONLINE_SET_PENHORA_EXIGENCIA_URL_ARQUIVO=
# Ou vários: [{"Nome":"Nota de exigência","URLArquivo":"https://.../doc.pdf"}]
PENHORA_ONLINE_SET_PENHORA_EXIGENCIA_ANEXOS_JSON=
# PENHORA_ONLINE_SET_PENHORA_EXIGENCIA_SKIP_PEDIDO_CHECK=true  # ignora pré-validação GetPedidoPO

# Penhora Online — SetPedidoPessoaRespondidoPO (§ 3.3.23): certidão por pessoa (IDTipoPedido=2)
PENHORA_ONLINE_SET_PEDIDO_PESSOA_RESPONDIDO_ID_PEDIDO=
PENHORA_ONLINE_SET_PEDIDO_PESSOA_RESPONDIDO_RESPOSTA=
# Negativa: true/false ou 1/0 (padrão false)
PENHORA_ONLINE_SET_PEDIDO_PESSOA_RESPONDIDO_NEGATIVA=false
# Um anexo:
PENHORA_ONLINE_SET_PEDIDO_PESSOA_RESPONDIDO_MATRICULA=
PENHORA_ONLINE_SET_PEDIDO_PESSOA_RESPONDIDO_URL_ARQUIVO=
# Ou vários: [{"Matricula":"12345","URLArquivo":"https://..."}]
PENHORA_ONLINE_SET_PEDIDO_PESSOA_RESPONDIDO_ANEXOS_JSON=

# Penhora Online — ListPedidosPO (§ 3.3.1)
PENHORA_ONLINE_WSDL_PATH=wsdl/penhoraonline.wsdl
PENHORA_ONLINE_ENDPOINT=https://hml3-wsoficio.onr.org.br/penhoraonline.asmx
PENHORA_ONLINE_AUTO_LOGIN=true
PENHORA_ONLINE_MAX_ROW_PER_PAGE=50
PENHORA_ONLINE_PAGE_NUMBER=1
PENHORA_ONLINE_PROTOCOLO=
# IDVara: -1 = todas (use ListVarasPO para códigos)
PENHORA_ONLINE_ID_VARA=-1
# IDTipoPedido: 1=Matrícula, 2=Pessoa, 3=Penhora, -1=Todos
PENHORA_ONLINE_ID_TIPO_PEDIDO=-1
# IDStatus: ver spec § 3.3.1, -1=Todos
PENHORA_ONLINE_ID_STATUS=-1
# Datas obrigatórias (aaaa-mm-dd), período máx. 30 dias
PENHORA_ONLINE_DATA_SOLICITACAO_INICIAL=2025-01-01
PENHORA_ONLINE_DATA_SOLICITACAO_FINAL=2025-01-31
# Filtro opcional por data de resposta (aaaa-mm-dd)
PENHORA_ONLINE_DATA_RESPOSTA_INICIAL=
PENHORA_ONLINE_DATA_RESPOSTA_FINAL=
