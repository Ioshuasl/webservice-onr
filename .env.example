# Penhora Online — ListPedidosExportacaoPO / _v2 (§ 3.3.36): exportação detalhada (mesmos filtros que ListPedidosPO)
# v2: mesmos filtros; resposta com ValorDaDivida e PercentualExecutado/PercentualPenhorado em Imovel[]

# Penhora Online — ListPedidosPO (§ 3.3.1)
PENHORA_ONLINE_WSDL_PATH=wsdl/penhoraonline.wsdl
PENHORA_ONLINE_ENDPOINT=https://hml3-wsoficio.onr.org.br/penhoraonline.asmx
PENHORA_ONLINE_AUTO_LOGIN=true
PENHORA_ONLINE_MAX_ROW_PER_PAGE=50
PENHORA_ONLINE_PAGE_NUMBER=1
PENHORA_ONLINE_PROTOCOLO=
# IDVara: -1 = todas (use ListVarasPO para códigos)
PENHORA_ONLINE_ID_VARA=-1
# IDTipoPedido: 1=Matrícula, 2=Pessoa, 3=Penhora, -1=Todos
PENHORA_ONLINE_ID_TIPO_PEDIDO=-1
# IDStatus: ver spec § 3.3.1, -1=Todos
PENHORA_ONLINE_ID_STATUS=-1
# Datas obrigatórias (aaaa-mm-dd), período máx. 30 dias
PENHORA_ONLINE_DATA_SOLICITACAO_INICIAL=2025-01-01
PENHORA_ONLINE_DATA_SOLICITACAO_FINAL=2025-01-31
# Filtro opcional por data de resposta (aaaa-mm-dd)
PENHORA_ONLINE_DATA_RESPOSTA_INICIAL=
PENHORA_ONLINE_DATA_RESPOSTA_FINAL=

# BD Light — ListArquivosXMLBDL (§ 3.4.1)
BDLIGHT_WSDL_PATH=wsdl/bdlight.wsdl
BDLIGHT_ENDPOINT=https://hml3-wsoficio.onr.org.br/bdlight.asmx
BDLIGHT_AUTO_LOGIN=true
BDLIGHT_MAX_ROW_PER_PAGE=50
BDLIGHT_PAGE_NUMBER=1
# Datas de importação (aaaa-mm-dd), período máx. 90 dias
BDLIGHT_DATA_INICIAL=2025-01-01
BDLIGHT_DATA_FINAL=2025-03-31
# GetArquivoXMLBDL — código retornado por ListArquivosXMLBDL ou ImportarArquivoBDL
BDLIGHT_ID_ARQUIVO=
# ImportarArquivoBDL — URL(s) pública(s) do .xml (máx. 5MB, modelo spec § 4.1)
BDLIGHT_IMPORTAR_URL_ARQUIVO=
# BDLIGHT_IMPORTAR_URLS=https://a.xml,https://b.xml
# BDLIGHT_IMPORTAR_ARQUIVOS_JSON=[{"URLArquivo":"https://exemplo/arquivo.xml"}]
# Validação local (padrão bdlight-xml-exemplo/bdlight-exemplo-1.xml) antes do SOAP
BDLIGHT_IMPORTAR_VALIDAR_XML=true
BDLIGHT_IMPORTAR_XML_PATH=bdlight-xml-exemplo/bdlight-exemplo-1.xml
# SetBDLightAtualizado — apenas Hash (usa BDLIGHT_* / login acima)

