                          },
                          "endereco_residencia": {
                            "type": "object",
                            "properties": {
                              "cep": {
                                "type": "string",
                                "example": "01227-200"
                              },
                              "logradouro": {
                                "type": "string",
                                "example": "avenida angelica"
                              },
                              "numero": {
                                "type": "string",
                                "example": "123"
                              },
                              "complemento": {
                                "type": "string",
                                "example": ""
                              },
                              "bairro": {
                                "type": "string",
                                "example": "consolacação"
                              },
                              "ibge_municipio": {
                                "type": "string",
                                "example": "3550308"
                              }
                            }
                          },
                          "descricao_domicilio_estrangeiro": {
                            "type": "string",
                            "example": ""
                          },
                          "filiacao": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "nome_genitor": {
                                  "type": "string",
                                  "example": "José Silva"
                                },
                                "sexo_genitor": {
                                  "type": "string",
                                  "example": "masculino"
                                }
                              }
                            }
                          }
                        }
                      },
                      "conjuge_2": {
                        "type": "object",
                        "properties": {
                          "cpf": {
                            "type": "string",
                            "example": "22105769039"
                          },
                          "nome": {
                            "type": "string",
                            "example": "João Silva"
                          },
                          "novo_nome": {
                            "type": "string",
                            "example": ""
                          },
                          "sexo": {
                            "type": "string",
                            "example": "masculino"
                          },
                          "data_nascimento": {
                            "type": "string",
                            "example": "28/03/2025"
                          },
                          "estado_civil": {
                            "type": "string",
                            "example": "SOLTEIRO"
                          },
                          "ocupacao": {
                            "type": "string",
                            "example": ""
                          },
                          "naturalidade_estrangeiro": {
                            "type": "boolean",
                            "example": true
                          },
                          "ibge_municipio_naturalidade": {
                            "type": "string",
                            "example": "3550308"
                          },
                          "descricao_naturalidade_estrangeiro": {
                            "type": "string",
                            "example": ""
                          },
                          "pais_nascimento": {
                            "type": "string",
                            "example": "076"
                          },
                          "nacionalidade": {
                            "type": "string",
                            "example": "076"
                          },
                          "domicilio_estrangeiro": {
                            "type": "boolean",
                            "example": true
                          },
                          "endereco_residencia": {
                            "type": "object",
                            "properties": {
                              "cep": {
                                "type": "string",
                                "example": "01227-200"
                              },
                              "logradouro": {
                                "type": "string",
                                "example": "avenida angelica"
                              },
                              "numero": {
                                "type": "string",
                                "example": "123"
                              },
                              "complemento": {
                                "type": "string",
                                "example": ""
                              },
