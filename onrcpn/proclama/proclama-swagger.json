                            "type": "string",
                            "example": ""
                          },
                          "sexo": {
                            "type": "string",
                            "example": "masculino"
                          },
                          "data_nascimento": {
                            "type": "string",
                            "example": "28/03/2025"
                          },
                          "estado_civil": {
                            "type": "string",
                            "example": "SOLTEIRO"
                          },
                          "ocupacao": {
                            "type": "string",
                            "example": ""
                          },
                          "naturalidade_estrangeiro": {
                            "type": "boolean",
                            "example": true
                          },
                          "ibge_municipio_naturalidade": {
                            "type": "string",
                            "example": "3550308"
                          },
                          "descricao_naturalidade_estrangeiro": {
                            "type": "string",
                            "example": ""
                          },
                          "pais_nascimento": {
                            "type": "string",
                            "example": "076"
                          },
                          "nacionalidade": {
                            "type": "string",
                            "example": "076"
                          },
                          "domicilio_estrangeiro": {
                            "type": "boolean",
