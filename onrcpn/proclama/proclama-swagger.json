                            "type": "string",
                            "example": "Foi encontrado um ou mais erros na validação dos dados do lote."
                          },
                          "errors": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "field": {
                                  "type": "string",
                                  "example": "sexo_genitor"
                                },
                                "message": {
                                  "type": "string",
                                  "example": "O campo sexo do genitor cônjuge 2 se encontra inválido. Informar masculino ou feminino. Foi informado M"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "type": "object",
              "properties": {
