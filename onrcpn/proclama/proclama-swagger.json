    "/api/proclama/recibo/:matricula": {
      "get": {
        "tags": [
          "Endpoints"
        ],
        "description": "Gera recibo em pdf base64 para o proclama especificado",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string",
            "description": "Token obtido via IDRC, conforme nota. Utilizar padrão Bearer <i>Token</i>."
          },
          {
            "name": "matricula",
            "in": "path",
            "type": "string",
            "description": "Número da matrícula do proclama"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "success"
                },
                "message": {
                  "type": "string",
                  "example": "operation finished succefully"
                },
                "recibo": {
                  "type": "string",
                  "example": "<<html string>>"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "type": "object",
              "properties": {
                "auth": {
                  "type": "boolean",
                  "example": false
                },
                "message": {
                  "type": "string",
                  "example": "Token expirado"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "the input received is incorrect"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "an error has occured"
                },
                "details": {
                  "type": "string",
                  "example": "<<Error Log>>"
                }
              }
            }
          }
        }
      }
    }
  }
