                      },
                      "data_proclamas": {
                        "type": "string",
                        "example": "28/03/2025"
                      },
                      "tipo_casamento": {
                        "type": "string",
                        "example": "civil"
                      },
                      "cpf_fatura": {
                        "type": "string",
                        "example": "22105769039"
                      },
                      "nome_fatura": {
                        "type": "string",
                        "example": "João Silva"
                      },
                      "conjuge_1": {
