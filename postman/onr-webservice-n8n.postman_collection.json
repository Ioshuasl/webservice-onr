                  "  return pm.variables.get(key);",
                  "}",
                  "const required = ['onr_hash', 'ACOMPANHAMENTO_TITULOS_INSERT_PROTOCOLO', 'ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_NOME', 'ACOMPANHAMENTO_TITULOS_INSERT_DATA_PROTOCOLO', 'ACOMPANHAMENTO_TITULOS_INSERT_DATA_PREVISAO_ENTREGA', 'ACOMPANHAMENTO_TITULOS_INSERT_MODO_NOTIFICACAO', 'ACOMPANHAMENTO_TITULOS_INSERT_INTERESSADO_NOME', 'ACOMPANHAMENTO_TITULOS_INSERT_NATUREZA_TITULO', 'ACOMPANHAMENTO_TITULOS_INSERT_CODIGO_VERIFICADOR', 'ACOMPANHAMENTO_TITULOS_INSERT_TIPO_SOLICITACAO', 'ACOMPANHAMENTO_TITULOS_INSERT_ID_TIPO_STATUS', 'ACOMPANHAMENTO_TITULOS_INSERT_DATA_STATUS'];",
                  "const missing = required.filter((k) => !getVar(k));",
                  "if (missing.length) {",
                  "  throw new Error('Variáveis ausentes: ' + missing.join(', ') + '. Execute Auth ONR — Login antes.');",
                  "}",
                  "const modo = String(getVar('ACOMPANHAMENTO_TITULOS_INSERT_MODO_NOTIFICACAO') || '').toUpperCase();",
                  "if (modo === 'E' && !getVar('ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_EMAIL')) {",
                  "  throw new Error('Com MODO_NOTIFICACAO=E, defina ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_EMAIL.');",
                  "}",
                  "if (modo === 'S' && (!getVar('ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_DDD') || !getVar('ACOMPANHAMENTO_TITULOS_INSERT_APRESENTANTE_TELEFONE'))) {",
