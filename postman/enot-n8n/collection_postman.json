    {
      "name": "n8n — proxy ENOT",
      "description": "Webhooks n8n (HTTP→REST). Preencher conforme implementação dos workflows AUTENOT-1…8.",
      "item": [
        {
          "name": "Catálogo",
          "item": [
            {
              "name": "[AUTENOT-1] Cities",
              "description": "POST /enot/catalogo/cities → GET /api/parent/cities",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "function getVar(key) {",
                      "  const fromEnv = pm.environment.get(key);",
                      "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
                      "  return pm.collectionVariables.get(key);",
                      "}",
                      "if (!getVar('ENOT_API_KEY')) {",
                      "  throw new Error('ENOT_API_KEY vazio. Configure no environment ou informe api_key no body.');",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status_http espelha HTTP', () => {",
                      "  const json = pm.response.json();",
                      "  pm.expect(pm.response.code).to.eql(json.status_http);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"ambiente\": \"{{ENOT_AMBIENTE}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{n8n_base_url}}/{{n8n_webhook_mode}}/{{enot_webhook_path_cities}}"
              }
            }
          ]
        },
        {
          "name": "Documento",
          "item": [
            {
              "name": "[AUTENOT-2] Uploads",
              "description": "POST /enot/documento/upload → POST /api/uploads (multipart PDF/A).",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "function getVar(key) {",
                      "  const fromEnv = pm.environment.get(key);",
                      "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
                      "  return pm.collectionVariables.get(key);",
                      "}",
                      "if (!getVar('ENOT_API_KEY')) {",
                      "  throw new Error('ENOT_API_KEY vazio. Configure no environment ou informe api_key no form-data.');",
                      "}",
                      "const pdfPath = getVar('ENOT_PDF_PATH');",
                      "if (pdfPath) {",
                      "  const fileRow = pm.request.body.formdata.find((r) => r.key === 'file');",
                      "  if (fileRow) fileRow.src = pdfPath;",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status_http espelha HTTP', () => {",
                      "  const json = pm.response.json();",
                      "  pm.expect(pm.response.code).to.eql(json.status_http);",
                      "});",
                      "pm.test('Upload retorna id do arquivo', () => {",
                      "  const json = pm.response.json();",
                      "  if (json.sucesso) {",
                      "    pm.expect(json.dados).to.be.an('object');",
                      "    pm.expect(json.dados.id).to.be.a('string').and.not.empty;",
                      "    pm.environment.set('enot_upload_id', json.dados.id);",
                      "    pm.collectionVariables.set('enot_upload_id', json.dados.id);",
                      "  }",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "file",
                      "description": "PDF/A do ato do livro",
                      "type": "file",
                      "src": []
                    },
                    {
                      "key": "ambiente",
                      "value": "{{ENOT_AMBIENTE}}",
                      "type": "text"
                    }
                  ]
                },
                "url": "{{n8n_base_url}}/{{n8n_webhook_mode}}/{{enot_webhook_path_upload}}",
                "description": "Multipart com campo **file** (PDF/A). Opcional: `api_key` no form-data.\n\nDefina `ENOT_PDF_PATH` no environment para anexar automaticamente um PDF de teste."
              }
            }
          ]
        },
        {
          "name": "Fluxo",
          "item": [
            {
              "name": "[AUTENOT-3] DocumentsCreate",
              "description": "POST /enot/fluxo/criar → POST /api/documents (criação do fluxo de assinaturas). Pré-requisito: AUTENOT-2 (upload) e opcional AUTENOT-1 (city_id).",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "function getVar(key) {",
                      "  const fromEnv = pm.environment.get(key);",
                      "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
                      "  return pm.collectionVariables.get(key);",
                      "}",
                      "if (!getVar('ENOT_API_KEY')) {",
                      "  throw new Error('ENOT_API_KEY vazio. Configure no environment ou informe api_key no body.');",
                      "}",
                      "if (!getVar('ENOT_ORGANIZATION_ID')) {",
                      "  throw new Error('ENOT_ORGANIZATION_ID vazio. Configure no environment ou informe organization_id no body.');",
                      "}",
                      "if (!getVar('enot_upload_id')) {",
                      "  console.warn('enot_upload_id vazio — execute [AUTENOT-2] Uploads antes ou preencha manualmente.');",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status_http espelha HTTP', () => {",
                      "  const json = pm.response.json();",
                      "  pm.expect(pm.response.code).to.eql(json.status_http);",
                      "});",
                      "pm.test('DocumentsCreate retorna id do fluxo', () => {",
                      "  const json = pm.response.json();",
                      "  if (json.sucesso) {",
                      "    pm.expect(json.dados).to.be.an('object');",
                      "    pm.expect(json.dados.id).to.be.a('string').and.not.empty;",
                      "    pm.environment.set('enot_document_id', json.dados.id);",
                      "    pm.collectionVariables.set('enot_document_id', json.dados.id);",
                      "  }",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"ambiente\": \"{{ENOT_AMBIENTE}}\",\n  \"auth_mode\": \"api_key\",\n  \"organization_id\": \"{{ENOT_ORGANIZATION_ID}}\",\n  \"type\": \"Deed\",\n  \"is_hybrid_act\": false,\n  \"has_real_estates\": false,\n  \"real_estates\": [],\n  \"residences\": [\n    {\n      \"is_foreign\": false,\n      \"quantity\": 1,\n      \"city_id\": \"{{enot_city_id}}\"\n    }\n  ],\n  \"findings\": [],\n  \"files\": [\n    {\n      \"id\": \"{{enot_upload_id}}\",\n      \"name\": \"ato-livro.pdf\",\n      \"display_name\": \"Escritura livro 10 folha 15\",\n      \"content_type\": \"application/pdf\"\n    }\n  ],\n  \"flow_actions\": [\n    {\n      \"type\": \"Signer\",\n      \"step\": 1,\n      \"user\": {\n        \"name\": \"Participante Teste\",\n        \"identifier\": \"12345678909\",\n        \"email\": \"participante.teste@example.com\"\n      },\n      \"title\": \"Outorgante\"\n    }\n  ],\n  \"protocol\": \"PROT-2026-0001\",\n  \"notarization_date\": \"2026-06-17T12:00:00.000Z\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{n8n_base_url}}/{{n8n_webhook_mode}}/{{enot_webhook_path_fluxo_criar}}",
                "description": "Cria fluxo de assinaturas no e-Notariado.\n\n**Auth upstream (interno):** padrão `X-Api-Key` com `ENOT_API_KEY`. Para espelhar a coleção CNB (`signer-cnb`), use `auth_mode: bearer` ou header `Authorization: Bearer`.\n\n**Campos v2.3+ obrigatórios:** `is_hybrid_act`, `has_real_estates`, `real_estates`, `residences`, `findings` (para `NotarialMinutes`)."
              }
            },
            {
              "name": "[AUTENOT-4] DocumentsList",
              "description": "POST /enot/fluxo/listar → GET /api/documents (lista atos do cartório). Etapa 1 do fluxo de assinaturas.",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "function getVar(key) {",
                      "  const fromEnv = pm.environment.get(key);",
                      "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
                      "  return pm.collectionVariables.get(key);",
                      "}",
                      "if (!getVar('ENOT_API_KEY')) {",
                      "  throw new Error('ENOT_API_KEY vazio. Configure no environment ou informe api_key no body.');",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status_http espelha HTTP', () => {",
                      "  const json = pm.response.json();",
                      "  pm.expect(pm.response.code).to.eql(json.status_http);",
                      "});",
                      "pm.test('DocumentsList retorna dados', () => {",
                      "  const json = pm.response.json();",
                      "  if (json.sucesso) {",
                      "    pm.expect(json.dados).to.exist;",
                      "    const items = Array.isArray(json.dados) ? json.dados : (json.dados.items || json.dados.data || []);",
                      "    if (Array.isArray(items) && items.length > 0 && items[0].id) {",
                      "      pm.environment.set('enot_document_id', items[0].id);",
                      "      pm.collectionVariables.set('enot_document_id', items[0].id);",
                      "    }",
                      "  }",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"ambiente\": \"{{ENOT_AMBIENTE}}\",\n  \"is_concluded\": true,\n  \"is_canceled\": false,\n  \"document_type\": \"Deed\",\n  \"limit\": 10,\n  \"offset\": 0,\n  \"order\": \"desc\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{n8n_base_url}}/{{n8n_webhook_mode}}/{{enot_webhook_path_fluxo_listar}}",
                "description": "Lista documentos/atos do fluxo de assinaturas.\n\n**Filtros opcionais (snake_case):** `is_concluded`, `is_canceled`, `document_type`, `limit`, `offset`, `order` (asc|desc).\n\nTodos os filtros são opcionais; omita para listar sem restrição adicional."
              }
            },
            {
              "name": "[AUTENOT-5] DocumentsGet",
              "description": "POST /enot/fluxo/detalhe → GET /api/documents/{id} (detalhe e versão assinada do traslado). Etapa 2 do fluxo de assinaturas.",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "function getVar(key) {",
