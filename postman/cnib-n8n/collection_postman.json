                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "function getVar(key) {",
                      "  const fromEnv = pm.environment.get(key);",
                      "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
                      "  return pm.collectionVariables.get(key);",
                      "}",
                      "if (!getVar('cnib_access_token')) {",
                      "  throw new Error('cnib_access_token vazio. Execute [AUTCNIB-1] Auth Token primeiro.');",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status_http espelha HTTP', () => {",
