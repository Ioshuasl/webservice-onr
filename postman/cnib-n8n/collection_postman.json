      "name": "n8n — proxy CNIB",
      "description": "Webhooks n8n (HTTP→REST). Paths e IDs serão preenchidos na implementação dos workflows AUTCNIB-1…6.",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "[AUTCNIB-1] Auth Token",
              "description": "Proxy n8n — workflow `[AUTCNIB-1] (cnib) AuthToken - CNIB`.\n\nWorkflow ID: `HZmL8lfjeauwkDzN`\n\nWebhook `POST /cnib/auth/token` — proxy `POST https://auth.id.onr.org.br/connect/token` (form-urlencoded, scope `cnib-serventia-api`). Sucesso grava `cnib_access_token`.",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "function getVar(key) {",
                      "  const fromEnv = pm.environment.get(key);",
                      "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
                      "  return pm.collectionVariables.get(key);",
                      "}",
                      "if (!getVar('CNIB_API_CLIENT_ID') || !getVar('CNIB_API_CLIENT_SECRET')) {",
                      "  console.warn('CNIB_API_CLIENT_ID ou CNIB_API_CLIENT_SECRET vazio: preencha no environment (vault env#CNIB).');",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                      "let json;",
                      "pm.test('Resposta JSON válida', () => {",
                      "  json = pm.response.json();",
                      "  pm.expect(json).to.be.an('object');",
                      "});",
                      "pm.test('Token obtido com sucesso', () => {",
                      "  pm.expect(json.sucesso).to.eql(true);",
                      "  pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                      "});",
                      "if (json.access_token) {",
                      "  pm.collectionVariables.set('cnib_access_token', json.access_token);",
                      "  pm.environment.set('cnib_access_token', json.access_token);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"ambiente\": \"{{CNIB_AMBIENTE}}\",\n  \"client_id\": \"{{CNIB_API_CLIENT_ID}}\",\n  \"client_secret\": \"{{CNIB_API_CLIENT_SECRET}}\",\n  \"grant_type\": \"client_credentials\",\n  \"scope\": \"cnib-serventia-api\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{n8n_base_url}}/{{n8n_webhook_mode}}/{{cnib_webhook_path_auth}}"
              }
            }
          ]
        },
