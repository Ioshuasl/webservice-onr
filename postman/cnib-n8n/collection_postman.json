  "item": [
    {
      "name": "API upstream (referência CNIB)",
      "description": "Chamadas diretas à SERVENTIAS API (OAuth + endpoints). Use para validar credenciais antes dos proxies n8n.",
      "item": [
        {
          "name": "[AUTCNIB-1] OAuth — upstream (referência)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('access_token presente', () => {",
                  "  pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('cnib_access_token', json.access_token);",
                  "  pm.environment.set('cnib_access_token', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{CNIB_API_CLIENT_ID}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{CNIB_API_CLIENT_SECRET}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "cnib-serventia-api",
                  "type": "text"
                }
              ]
            },
            "url": "{{CNIB_AUTH_TOKEN_URL}}",
            "description": "Token OAuth2 CNIB. **Usar form-urlencoded** — body JSON retorna 400."
          }
        },
        {
          "name": "[AUTCNIB-3] Visualizar — upstream (referência)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function getVar(key) {",
                  "  const fromEnv = pm.environment.get(key);",
                  "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
                  "  return pm.collectionVariables.get(key);",
                  "}",
                  "const amb = getVar('CNIB_AMBIENTE') || 'producao';",
                  "const base = amb === 'stg' ? getVar('CNIB_API_BASE_URL_STG') : getVar('CNIB_API_BASE_URL');",
                  "pm.variables.set('cnib_upstream_base', base);",
                  "if (!getVar('cnib_access_token')) {",
                  "  console.warn('cnib_access_token vazio — execute OAuth primeiro.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{cnib_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
