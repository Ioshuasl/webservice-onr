                  "  return pm.collectionVariables.get(key);",
                  "}",
                  "if (!getVar('ccn_import_id')) {",
                  "  console.warn('ccn_import_id vazio: execute Upload XML CCN — HML antes ou preencha manualmente.');",
                  "}",
                  "if (!getVar('CCN_X_API_KEY')) {",
