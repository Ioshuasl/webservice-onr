              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));",
                  "const json = pm.response.json();",
                  "pm.test('Erro de arquivo ausente', () => {",
                  "  pm.expect(json.success).to.eql(false);",
                  "  pm.expect(JSON.stringify(json.errors)).to.include('arquivo_ausente');",
                  "});"
                ]
              }
            }
