    {
      "name": "CCN Get Import Erros",
      "description": "Webhook n8n — lista erros da importacao CCN. Upstream: `GET /api/imports/{id}/errors` (Swagger CCN oficial).",
      "item": [
        {
          "name": "Get Import Erros — HML",
          "description": "Consulta somente os erros da importacao pelo UUID retornado no upload.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function getVar(key) {",
                  "  const fromEnv = pm.environment.get(key);",
                  "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
                  "  return pm.collectionVariables.get(key);",
                  "}",
                  "if (!getVar('ccn_import_id')) {",
                  "  console.warn('ccn_import_id vazio: execute Upload XML CCN — HML antes ou preencha manualmente.');",
                  "}",
                  "if (!getVar('CCN_X_API_KEY')) {",
                  "  console.warn('CCN_X_API_KEY vazio: preencha no environment (vault ambiente-homologacao-api#CCN).');",
                  "}",
                  "if (getVar('n8n_webhook_mode') === 'webhook-test') {",
                  "  console.warn('Modo webhook-test: abra CCN Get Import Erros no n8n e clique Execute workflow antes de enviar.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Consulta de erros aceita', () => {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.erros).to.be.an('array');",
                  "  pm.expect(json.importId).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "console.log('total erros:', json.erros?.length ?? 0);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Ambiente",
                "value": "{{CCN_X_AMBIENTE}}"
              },
              {
                "key": "X-Ccn-Api-Key",
                "value": "{{CCN_X_API_KEY}}"
              }
            ],
            "url": "{{n8n_base_url}}/{{n8n_webhook_mode}}/{{n8n_webhook_id_ccn_import_erros}}/ccn/imports/{{ccn_import_id}}/erros",
            "description": "URL com webhookId prefixado (path dinâmico `:id` no n8n). Usa `ccn_import_id` salvo pelo upload. Resposta: `{ success, importId, erros: [] }`."
          },
          "response": []
        },
