  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function getVar(key) {",
          "  const fromEnv = pm.environment.get(key);",
          "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
          "  const fromCollection = pm.collectionVariables.get(key);",
          "  if (fromCollection !== undefined && fromCollection !== null && String(fromCollection).length > 0) return fromCollection;",
          "  return pm.variables.get(key);",
          "}",
          "",
          "function hasBasicAuthConfigured() {",
          "  const auth = pm.request.auth;",
          "  if (!auth || auth.type !== 'basic' || !Array.isArray(auth.basic)) return false;",
          "  const user = auth.basic.find((x) => x.key === 'username')?.value;",
          "  const pass = auth.basic.find((x) => x.key === 'password')?.value;",
          "  return Boolean(user && pass && !String(user).includes('{{') && !String(pass).includes('{{'));",
          "}",
          "",
          "const required = ['n8n_base_url', 'n8n_webhook_mode', 'ccn_n8n_webhook_path'];",
          "if (!getVar('N8N_BASIC_AUTH_USER') || !getVar('N8N_BASIC_AUTH_PASSWORD')) {",
          "  if (!hasBasicAuthConfigured()) {",
          "    required.push('N8N_BASIC_AUTH_USER', 'N8N_BASIC_AUTH_PASSWORD');",
          "  }",
          "}",
          "const missing = required.filter((k) => !getVar(k));",
          "if (missing.length) {",
          "  throw new Error('Variáveis ausentes: ' + missing.join(', '));",
          "}",
          "",
          "if (getVar('n8n_webhook_mode') === 'webhook-test') {",
          "  console.warn('Modo webhook-test: abra CCN Upload XML no n8n e clique Execute workflow antes de enviar.');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "CCN Upload XML",
      "description": "Webhook n8n — upload de XML CCN para e-notariado (`POST /api/uploads`).",
      "item": [
        {
          "name": "Upload XML CCN — HML",
          "description": "Envia XML válido com raiz `<pessoas>` para homologação e-notariado.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function getVar(key) {",
                  "  const fromEnv = pm.environment.get(key);",
                  "  if (fromEnv !== undefined && fromEnv !== null && String(fromEnv).length > 0) return fromEnv;",
                  "  return pm.collectionVariables.get(key);",
                  "}",
                  "if (!getVar('CCN_X_API_KEY')) {",
                  "  console.warn('CCN_X_API_KEY vazio: preencha no environment (vault ambiente-homologacao-api#CCN).');",
                  "}",
                  "const xmlPath = getVar('CCN_XML_PATH');",
                  "if (!xmlPath) {",
                  "  console.warn('CCN_XML_PATH vazio: defina no environment o caminho absoluto do .xml.');",
                  "} else {",
                  "  const fileRow = pm.request.body.formdata.find((r) => r.key === 'file');",
                  "  if (fileRow) fileRow.src = xmlPath;",
                  "  if (!xmlPath.includes('/') && !xmlPath.includes('\\\\')) {",
                  "    console.warn('CCN_XML_PATH parece so o nome do arquivo; use caminho completo.');",
                  "  }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Upload aceito', () => {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.upload).to.be.an('object');",
                  "  pm.expect(json.upload.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.upload.location).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (json.upload?.id) pm.environment.set('ccn_upload_id', json.upload.id);",
                  "if (json.upload?.location) pm.environment.set('ccn_upload_location', json.upload.location);",
                  "",
                  "console.log('upload.id:', json.upload?.id);",
                  "console.log('upload.location:', json.upload?.location);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Ambiente",
                "value": "{{CCN_X_AMBIENTE}}"
              },
              {
                "key": "X-Ccn-Api-Key",
                "value": "{{CCN_X_API_KEY}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Arquivo XML CCN (encoding ISO-8859-1). O pre-request define src a partir de CCN_XML_PATH.",
                  "type": "file",
                  "src": "c:/Users/kenio/automacoes e testes/scripts/ccn/exemplo-ccn-minimo.xml"
                }
              ]
            },
            "url": "{{n8n_base_url}}/{{n8n_webhook_mode}}/{{ccn_n8n_webhook_path}}",
            "description": "Multipart com campo **file** (XML). Headers `X-Ambiente` e `X-Ccn-Api-Key`.\n\nUse `scripts/ccn/exemplo-ccn-minimo.xml` ou [CCN20251123-1.xml](https://orius-tools.s3.sa-east-1.amazonaws.com/community/1777905117317-CCN20251123-1.xml)."
          },
          "response": []
        },
        {
          "name": "Upload XML CCN — sem arquivo",
          "description": "Deve retornar 422 `arquivo_ausente`.",
          "event": [
            {
