        "rawContentType": "text/xml",
        "body": "=<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <tns:LoginUsuarioCertificado xmlns:tns=\"http://tempuri.org/WSOficio\">\n      <tns:oRequest>\n        <tns:SUBJECTCN>{{ $json.subjectcn }}</tns:SUBJECTCN>\n        <tns:ISSUERO>{{ $json.issuero }}</tns:ISSUERO>\n        <tns:PUBLICKEY>{{ $json.publickey }}</tns:PUBLICKEY>\n        <tns:SERIALNUMBER>{{ $json.serialnumber }}</tns:SERIALNUMBER>\n        <tns:VALIDUNTIL>{{ $json.validuntil }}</tns:VALIDUNTIL>\n        <tns:CPF>{{ $json.cpf }}</tns:CPF>\n        <tns:EMAIL>{{ $json.email }}</tns:EMAIL>\n        <tns:IDParceiroWS>{{ $json.idparceirows }}</tns:IDParceiroWS>\n      </tns:oRequest>\n    </tns:LoginUsuarioCertificado>\n  </soap:Body>\n</soap:Envelope>",
