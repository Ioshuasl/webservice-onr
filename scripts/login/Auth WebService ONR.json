    {
      "parameters": {
        "jsCode": "// Acessa o XML dentro da propriedade \"data\" do item atual\nconst xml = $input.first().json.data;\n\nif (!xml || typeof xml !== 'string') {\n    throw new Error('Propriedade \"data\" contendo o XML não foi encontrada.');\n}\n\n// Função para extrair o valor de uma tag simples\nconst getTagValue = (tag, source) => {\n    const regex = new RegExp(`<${tag}>(.*?)</${tag}>`, 's');\n    const match = source.match(regex);\n    return match ? match[1].trim() : '';\n};\n\n// Função para varrer e extrair todas as tags <string> de dentro de <Tokens>\nconst extractTokens = (source) => {\n    const tokensSection = getTagValue('Tokens', source);\n    const tokenRegex = /<string>(.*?)<\\/string>/g;\n    const tokens = [];\n    let match;\n    \n    while ((match = tokenRegex.exec(tokensSection)) !== null) {\n        tokens.push(match[1]);\n    }\n    return tokens;\n};\n\n// Monta e tipa o JSON final de forma limpa\nconst resultadoJson = {\n    RETORNO: getTagValue('RETORNO', xml) === 'true',\n    CODIGOERRO: parseInt(getTagValue('CODIGOERRO', xml) || '0', 10),\n    ERRODESCRICAO: getTagValue('ERRODESCRICAO', xml),\n    IDUsuario: parseInt(getTagValue('IDUsuario', xml), 10),\n    IDInstituicao: parseInt(getTagValue('IDInstituicao', xml), 10),\n    Ativo: getTagValue('Ativo', xml) === 'true',\n    Tokens: extractTokens(xml)\n};\n\nreturn { json: resultadoJson };"
      },
