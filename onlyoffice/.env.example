# Copiar para onlyoffice/.env — NÃO commitar .env com secret real
# cp onlyoffice/.env.example onlyoffice/.env

# Imagem e portas
ONLYOFFICE_IMAGE_TAG=latest
ONLYOFFICE_HTTP_PORT=8080
# ONLYOFFICE_HTTPS_PORT=8443

# JWT — MESMO valor no app integrador (dev-server / backend Orius)
ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=troque_por_secret_longo_aleatorio
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_JWT_IN_BODY=false

# Dev Docker Desktop: permitir host.docker.internal e IPs privados
ONLYOFFICE_ALLOW_PRIVATE_IP=true
ONLYOFFICE_ALLOW_META_IP=true

# Serviços opcionais
ONLYOFFICE_WOPI_ENABLED=false
ONLYOFFICE_USE_UNAUTHORIZED_STORAGE=false
ONLYOFFICE_GENERATE_FONTS=true
ONLYOFFICE_PLUGINS_ENABLED=true
ONLYOFFICE_EXAMPLE_ENABLED=false
ONLYOFFICE_METRICS_ENABLED=false

# App de exemplo (npm run onlyoffice:dev) — alinhar JWT com acima
ONLYOFFICE_DS_URL=http://localhost:8080
ONLYOFFICE_APP_PORT=3001
ONLYOFFICE_APP_HOST=host.docker.internal
ONLYOFFICE_JWT_ENABLED_APP=true

# Produção — Let's Encrypt (descomente no docker-compose.yml também)
# ONLYOFFICE_LETS_ENCRYPT_DOMAIN=docs.seudominio.com.br
# ONLYOFFICE_LETS_ENCRYPT_MAIL=admin@seudominio.com.br
