      },
      "texto_normativo_exato": "documentos avulsos como orçamentos, mapas, atestados médicos, imagens e outros arquivos que tenham sido utilizados na lavratura de atas notariais."
    },
    {
      "chave": "V/II/II/art-347",
      "metadados_origem": {
        "livro": "V",
        "livro_nome": "DO TABELIONATO DE NOTAS",
        "titulo": {
          "id": "II",
          "nome": "DO ACERVO E DOS IMPRESSOS"
        },
        "capitulo": {
          "id": "II",
          "nome": "DOS ARQUIVOS, DAS PASTAS E DOS CLASSIFICADORES"
        },
        "artigo": "347",
        "paragrafo": null,
        "inciso": null
      },
      "texto_normativo_exato": "O Tabelionato de Notas manterá seu arquivo em formato físico ou digital, adotando classificadores de documento ou processo por ato lavrado, conforme estabelecido na Parte Geral deste Código."
    },
    {
      "chave": "V/II/III/art-348",
