        "livro_nome": "DO TABELIONATO DE NOTAS",
        "titulo": {
          "id": "II",
          "nome": "DO ACERVO E DOS IMPRESSOS"
        },
        "capitulo": {
          "id": "III",
          "nome": "DOS IMPRESSOS DE SEGURANÇA"
        },
        "artigo": "350",
        "paragrafo": null,
        "inciso": null
      },
      "texto_normativo_exato": "O tabelião de notas velará pela guarda dos impressos em local seguro."
    },
    {
      "chave": "V/II/III/art-351",
      "metadados_origem": {
        "livro": "V",
        "livro_nome": "DO TABELIONATO DE NOTAS",
        "titulo": {
          "id": "II",
          "nome": "DO ACERVO E DOS IMPRESSOS"
        },
        "capitulo": {
          "id": "III",
          "nome": "DOS IMPRESSOS DE SEGURANÇA"
        },
        "artigo": "351",
        "paragrafo": null,
        "inciso": null
      },
      "texto_normativo_exato": "Havendo, excepcionalmente, necessidade de lavratura de ato notarial em"
    },
    {
      "chave": "V/III/I/art-352",
      "metadados_origem": {
