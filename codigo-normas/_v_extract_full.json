        },
        "artigo": "352",
        "paragrafo": null,
        "inciso": "I"
      },
      "texto_normativo_exato": "data, com indicação do local, dia, mês e ano da lavratura;"
    },
    {
      "chave": "V/III/I/art-352/inciso-ii",
      "metadados_origem": {
        "livro": "V",
        "livro_nome": "DO TABELIONATO DE NOTAS",
