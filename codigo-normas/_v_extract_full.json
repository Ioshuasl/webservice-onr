        },
        "capitulo": {
          "id": "I",
          "nome": "DISPOSIÇÕES GERAIS"
        },
        "artigo": "352",
        "paragrafo": null,
        "inciso": null
      },
      "texto_normativo_exato": "São requisitos do ato notarial, além dos previstos no Código Civil, leis especiais e neste Código:"
    },
    {
      "chave": "V/III/I/art-352/inciso-i",
      "metadados_origem": {
