        },
        "artigo": "346",
        "paragrafo": null,
        "inciso": "I"
      },
      "texto_normativo_exato": "documentos pessoais, como carteira de identidade, CPF/MF, certidões comprobatórias de estado civil e comprovante de endereço;"
