        "livro_nome": "DO TABELIONATO DE NOTAS",
        "titulo": {
          "id": "II",
          "nome": "DO ACERVO E DOS IMPRESSOS"
        },
        "capitulo": {
          "id": "II",
          "nome": "DOS ARQUIVOS, DAS PASTAS E DOS CLASSIFICADORES"
        },
        "artigo": "346",
        "paragrafo": null,
        "inciso": null
      },
      "texto_normativo_exato": "O Tabelionato de Notas manterá original ou cópia de:"
    },
    {
      "chave": "V/II/II/art-346/inciso-i",
      "metadados_origem": {
        "livro": "V",
