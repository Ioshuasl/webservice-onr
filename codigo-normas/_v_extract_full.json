          "nome": "DO ACERVO E DOS IMPRESSOS"
        },
        "capitulo": {
          "id": "III",
          "nome": "DOS IMPRESSOS DE SEGURANÇA"
        },
        "artigo": "348",
        "paragrafo": null,
        "inciso": null
      },
      "texto_normativo_exato": "O uso de papel e etiqueta de segurança é obrigatório para lavratura do ato notarial."
    },
    {
      "chave": "V/II/III/art-348/paragrafo-unico",
      "metadados_origem": {
        "livro": "V",
        "livro_nome": "DO TABELIONATO DE NOTAS",
        "titulo": {
          "id": "II",
          "nome": "DO ACERVO E DOS IMPRESSOS"
        },
        "capitulo": {
          "id": "III",
          "nome": "DOS IMPRESSOS DE SEGURANÇA"
        },
        "artigo": "348",
        "paragrafo": "§único",
        "inciso": null
      },
      "texto_normativo_exato": "O disposto no caput será cumprido por todas as serventias no prazo de até (6) seis meses, contados da vigência deste Código."
    },
    {
      "chave": "V/II/III/art-349",
      "metadados_origem": {
        "livro": "V",
        "livro_nome": "DO TABELIONATO DE NOTAS",
        "titulo": {
          "id": "II",
          "nome": "DO ACERVO E DOS IMPRESSOS"
        },
        "capitulo": {
          "id": "III",
          "nome": "DOS IMPRESSOS DE SEGURANÇA"
        },
        "artigo": "349",
        "paragrafo": null,
        "inciso": null
      },
      "texto_normativo_exato": "O modelo do papel e da etiqueta de segurança será desenvolvido pela própria serventia, a partir de padrão estabelecido pelo Colégio Notarial do Estado de Goiás e aprovado pela Corregedoria-Geral da Justiça."
    },
    {
      "chave": "V/II/III/art-350",
      "metadados_origem": {
